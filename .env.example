# Application settings
APP_ENV=development
LOG_LEVEL=INFO

# Data paths — defaults are absolute (resolved from package location in config.py).
# Override here only if you need to move data outside the project directory.
# DATA_DIR=/absolute/path/to/data
# DB_PATH=/absolute/path/to/court_edge.db

# NBA API settings
# nba_api uses public endpoints; no key required.
# Increase if you hit rate limits.
NBA_API_DELAY_SECONDS=0.6

# Ingestion defaults
DEFAULT_SEASON=2024-25

# Model settings
TRAIN_CUTOFF_DATE=2025-01-01
TEST_START_DATE=2025-01-01

# API server
API_HOST=0.0.0.0
API_PORT=8000

# OpenAI — required for the live context agent (GPT-4o)
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The Odds API — optional; enables prop line ingestion via scripts/fetch_odds.py
# Get your key at https://the-odds-api.com
# Leave blank to run the system without prop line data.
ODDS_API_KEY=
